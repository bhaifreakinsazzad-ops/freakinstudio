# Supabase project (hosted) — copy this file to .env.local for `npm run dev`
# and to .env.test for the integration test suite (tests/integration/).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — this key bypasses Row Level
# Security entirely. Used only in: scripts/*, tests/integration/*, and
# server-only route handlers / server actions. Never import it from a
# Client Component or anything bundled for the browser.
SUPABASE_SERVICE_ROLE_KEY=
